# ===== Telegram (required) =====
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID. Leave empty at first, message the bot, it will tell you.
# Several IDs: comma separated.
TELEGRAM_OWNER_IDS=

TIMEZONE=Africa/Cairo
# Morning digest time (HH:MM, in TIMEZONE), or "off"
DIGEST_TIME=08:00
DATA_DIR=data
CONTACTS_FILE=contacts.yaml

# ===== Sending email (SMTP) =====
# Gmail: smtp.gmail.com / 587 with an App Password (Google Account -> Security -> App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=

# ===== WhatsApp Cloud API (Meta) =====
# developers.facebook.com -> create app -> WhatsApp. Use a permanent System User token.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template whose body is just {{1}}. Needed to message people who haven't
# written to your WhatsApp business number in the last 24 hours.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en

# ===== Google Calendar =====
# Path to the service-account JSON key, and the calendar ID (usually your Gmail address).
# Share that calendar with the service account email ("Make changes to events").
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
GOOGLE_CALENDAR_ID=

# ===== Canvas =====
# e.g. https://aucegypt.instructure.com  (whatever your Canvas address is)
CANVAS_BASE_URL=
# Canvas -> Account -> Settings -> + New Access Token
CANVAS_TOKEN=
CANVAS_POLL_MINUTES=30

# ===== Inboxes to watch (up to 5: INBOX1_ ... INBOX5_) =====
INBOX_POLL_MINUTES=10

# Example 1: Gmail over IMAP (use an App Password)
INBOX1_TYPE=imap
INBOX1_NAME=Gmail
INBOX1_HOST=imap.gmail.com
INBOX1_USER=
INBOX1_PASSWORD=
# Optional filters - only report mails whose sender contains one of these,
# or whose subject/body contains one of the keywords. Leave both empty = report everything.
INBOX1_FILTER_FROM=
INBOX1_FILTER_KEYWORDS=announcement,deadline,urgent

# Example 2: University Outlook / Microsoft 365 (Graph API, sign in once with /outlook_login)
INBOX2_TYPE=graph
INBOX2_NAME=University
# Azure app registration "Application (client) ID" - see README
INBOX2_CLIENT_ID=
# "organizations", "common", or your university's tenant ID
INBOX2_TENANT=organizations
INBOX2_FILTER_FROM=
INBOX2_FILTER_KEYWORDS=
